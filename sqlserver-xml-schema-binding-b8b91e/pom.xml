<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>sqlserver-xml-schema-binding</artifactId>
    <version>0.0.3</version>
  </parent>

  <artifactId>sqlserver-xml-schema-binding-b8b91e</artifactId>

  <name>${project.artifactId}</name>
  <!-- the schema has no targetNamespace (its elements are in no namespace); the module is named after the namespace
       listed on https://schemas.microsoft.com/sqlserver/ -->
  <description>Jakarta XML Binding for http://schemas.microsoft.com/sqlserver/2012/upgradeadvisor/upgraderules</description>

  <properties>
    <!-- the package of generated classes, and the Automatic-Module-Name -->
    <module.name>io.github.jinahya.sqlserver.xml.schema.binding.b8b91e</module.name>
    <!-- downloaded by 'mvn -N antrun:run@download-schemas' (see the root pom.xml) -->
    <schema.path>sqlserver/2012/upgradeadvisor/upgraderules/BpaRepository.xsd</schema.path>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
