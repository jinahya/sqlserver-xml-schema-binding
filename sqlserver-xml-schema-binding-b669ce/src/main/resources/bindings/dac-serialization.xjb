<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  version="3.0">

  <jaxb:bindings schemaLocation="../../../../../schemas/sqlserver/dac/Serialization/2012/02/dacpac.xsd"
    node="/xsd:schema">
    <!-- PropertyType has both an element and an attribute named "Value" -->
    <jaxb:bindings node="xsd:complexType[@name='PropertyType']/xsd:attribute[@name='Value']">
      <jaxb:property name="ValueAttribute"/>
    </jaxb:bindings>
  </jaxb:bindings>

</jaxb:bindings>
