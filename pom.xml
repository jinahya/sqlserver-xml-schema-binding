  <!-- modules link to the repository itself, not to a non-existent <url>/<artifactId> -->
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:git@github.com:jinahya/sqlserver-xml-schema-binding.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/sqlserver-xml-schema-binding.git</developerConnection>
    <url>https://github.com/jinahya/sqlserver-xml-schema-binding</url>
    <tag>0.0.4</tag>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- https://central.sonatype.com/artifact/jakarta.xml.bind/jakarta.xml.bind-api/versions -->
    <version.jakarta.xml.bind-api>4.0.5</version.jakarta.xml.bind-api>
    <!-- https://central.sonatype.com/artifact/org.glassfish.jaxb/jaxb-runtime/versions -->
    <version.org.glassfish.jaxb>4.0.9</version.org.glassfish.jaxb>
    <!-- https://central.sonatype.com/artifact/org.jvnet.jaxb/jaxb-maven-plugin/versions -->
    <version.jaxb-maven-plugin>4.0.16</version.jaxb-maven-plugin>
    <!-- https://central.sonatype.com/artifact/org.jvnet.jaxb/jaxb-plugins/versions (XJC plugins, e.g. -Xinheritance) -->
    <version.jaxb-plugins>4.0.16</version.jaxb-plugins>
    <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/build-helper-maven-plugin/versions -->
    <version.build-helper-maven-plugin>3.6.1</version.build-helper-maven-plugin>
    <!-- https://central.sonatype.com/artifact/org.junit/junit-bom/versions -->
    <version.org.junit>6.1.3</version.org.junit>
    <!-- where schemas are downloaded (git-ignored, but the schemas/schemas.sha256 index); modules are direct children of the root -->
    <schemas.directory>${project.basedir}/../schemas</schemas.directory>
    <!-- sources generated into each module's package (@module.name@ replaced), e.g. the equals/hashCode strategies -->
    <templates.directory>${project.basedir}/../src/templates</templates.directory>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>jakarta.xml.bind</groupId>
        <artifactId>jakarta.xml.bind-api</artifactId>
        <version>${version.jakarta.xml.bind-api}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-runtime</artifactId>
        <version>${version.org.glassfish.jaxb}</version>
      </dependency>
      <dependency><!-- of jaxb-plugins-runtime; aligned with jaxb-runtime -->
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-core</artifactId>
        <version>${version.org.glassfish.jaxb}</version>
      </dependency>
      <dependency>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-plugins-runtime</artifactId>
        <version>${version.jaxb-plugins}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
    </dependency>
    <dependency><!-- of the equals/hashCode generated by -Xequals/-XhashCode -->
      <groupId>org.jvnet.jaxb</groupId>
      <artifactId>jaxb-plugins-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><!-- schemas are not redistributable, so they are never committed (only the schemas/schemas.sha256 index
               is) nor downloaded by the build; 'mvn -N antrun:run@download-schemas' downloads them (see below), and each
               module checks that its schemas/{schema.path} is listed in the index and there -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
          <executions>
            <execution>
              <id>check-schema</id>
              <phase>initialize</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <fail message="${schema.path} is not listed in schemas/schemas.sha256">
                    <condition>
                      <not>
                        <resourcecontains resource="${schemas.directory}/schemas.sha256" substring=" ${schema.path}" />
                      </not>
                    </condition>
                  </fail>
                  <fail message="${schemas.directory}/${schema.path} not found; run 'mvn -N antrun:run@download-schemas' first">
                    <condition>
                      <not>
                        <available file="${schemas.directory}/${schema.path}" />
                      </not>
                    </condition>
                  </fail>
                </target>
              </configuration>
            </execution>
            <execution>
              <!-- copies src/templates/{main,test}/*.java into the module's package (added as sources below) -->
              <id>generate-templates</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <loadresource property="package.path">
                    <string value="${module.name}" />
                    <filterchain>
                      <tokenfilter>
                        <replacestring from="." to="/" />
                      </tokenfilter>
                    </filterchain>
                  </loadresource>
                  <copy todir="${project.build.directory}/generated-sources/templates/${package.path}">
                    <fileset dir="${templates.directory}/main" includes="*.java" />
                    <filterset>
                      <filter token="module.name" value="${module.name}" />
                    </filterset>
                  </copy>
                  <copy todir="${project.build.directory}/generated-test-sources/templates/${package.path}">
                    <fileset dir="${templates.directory}/test" includes="*.java" />
                    <filterset>
                      <filter token="module.name" value="${module.name}" />
                    </filterset>
                  </copy>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${version.build-helper-maven-plugin}</version>
          <executions>
            <execution>
              <id>add-template-sources</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${project.build.directory}/generated-sources/templates</source>
                </sources>
              </configuration>
            </execution>
            <execution>
              <id>add-template-test-sources</id>
              <phase>generate-test-sources</phase>
              <goals>
                <goal>add-test-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${project.build.directory}/generated-test-sources/templates</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <archive>
              <manifestEntries>
                <!-- each module defines module.name -->
                <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jvnet.jaxb</groupId>
          <artifactId>jaxb-maven-plugin</artifactId>
          <version>${version.jaxb-maven-plugin}</version>
          <executions>
            <execution>
              <id>generate</id>
              <goals>
                <goal>generate</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <!-- downloaded by maven-antrun-plugin; only the module's own schema, not the others there -->
            <schemaDirectory>${schemas.directory}</schemaDirectory>
            <schemaIncludes>
              <include>${schema.path}</include>
            </schemaIncludes>
            <bindingDirectory>${project.basedir}/src/main/resources/bindings</bindingDirectory>
            <bindingIncludes>
              <include>**/*.xjb</include>
            </bindingIncludes>
            <strict>false</strict>
            <extension>true</extension>
            <noFileHeader>true</noFileHeader>
            <!-- value equals/hashCode (e.g. for JPA dirty checking), with the strategies of src/templates/main -->
            <args>
              <arg>-Xequals</arg>
              <arg>-Xequals-equalsStrategyClass=${module.name}.ValueEqualsStrategy</arg>
              <arg>-XhashCode</arg>
              <arg>-XhashCode-hashCodeStrategyClass=${module.name}.ValueHashCodeStrategy</arg>
            </args>
            <plugins>
              <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-plugins</artifactId>
                <version>${version.jaxb-plugins}</version>
              </plugin>
            </plugins>
            <!-- each module defines module.name -->
            <generatePackage>${module.name}</generatePackage>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin><!-- adds each module's sources generated from src/templates (see generate-templates) -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
      </plugin>
      <plugin><!-- mvn -N antrun:run@download-schemas
             downloads https://schemas.microsoft.com/{path} to schemas/{path} for each "sha256  path" line of
             schemas/schemas.sha256 (shasum format), unless already there, and verifies that each is byte-for-byte the
             expected file; run manually, or with -Pdownload-schemas (see the profile below), as release:perform does -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <!-- for modules only -->
            <id>check-schema</id>
            <phase>none</phase>
          </execution>
          <execution>
            <!-- for modules only -->
            <id>generate-templates</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>download-schemas</id>
            <phase>none</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- Ant has no loop: turn each "sha256  path" line of schemas/schemas.sha256 into a <schema/> call of a
                     generated build file, and run it -->
                <concat destfile="${project.build.directory}/download-schemas.xml">
                  <header filtering="no" trimleading="yes"><![CDATA[
                    <project name="download-schemas" default="download">
                      <macrodef name="schema">
                        <attribute name="path"/>
                        <attribute name="sha256"/>
                        <sequential>
                          <local name="dir"/>
                          <local name="ok"/>
                          <dirname property="dir" file="${schemas}/@{path}"/>
                          <mkdir dir="${dir}"/>
                          <get src="https://schemas.microsoft.com/@{path}" dest="${schemas}/@{path}" skipexisting="true"/>
                          <checksum file="${schemas}/@{path}" algorithm="SHA-256" property="@{sha256}" verifyproperty="ok"/>
                          <fail message="unexpected SHA-256 of schemas/@{path}">
                            <condition>
                              <isfalse value="${ok}"/>
                            </condition>
                          </fail>
                        </sequential>
                      </macrodef>
                      <target name="download">
                  ]]></header>
                  <fileset file="${project.basedir}/schemas/schemas.sha256" />
                  <filterchain>
                    <linecontainsregexp>
                      <regexp pattern="^[0-9a-f]{64}\s+\S+$" />
                    </linecontainsregexp>
                    <replaceregex pattern="^([0-9a-f]{64})\s+(\S+)$" replace="&lt;schema sha256=&quot;\1&quot; path=&quot;\2&quot;/&gt;" />
                  </filterchain>
                  <footer filtering="no"><![CDATA[
                      </target>
                    </project>
                  ]]></footer>
                </concat>
                <ant antfile="${project.build.directory}/download-schemas.xml" inheritall="false">
                  <property name="schemas" location="${project.basedir}/schemas" />
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- release:perform builds a fresh checkout of the tag, which has no (git-ignored) schemas; the profile
             downloads them there. Other settings, and the version, come from jinahya-parent -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <configuration>
          <releaseProfiles>download-schemas</releaseProfiles>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- binds download-schemas to the root's initialize, before any module checks its schema; e.g.
           ./mvnw -Pdownload-schemas verify, and release:perform (releaseProfiles) -->
      <id>download-schemas</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>download-schemas</id>
                <phase>initialize</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
