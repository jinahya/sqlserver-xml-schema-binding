<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>sqlserver-xml-schema-binding</artifactId>
    <version>0.0.6-SNAPSHOT</version>
  </parent>

  <artifactId>sqlserver-xml-schema-binding-bd5c8e</artifactId>

  <name>${project.artifactId}</name>
  <description>Jakarta XML Binding for http://schemas.microsoft.com/sqlserver/2004/SOAP/types/SqlResultStream</description>

  <properties>
    <!-- the package of generated classes, and the Automatic-Module-Name -->
    <module.name>io.github.jinahya.sqlserver.xml.schema.binding.bd5c8e</module.name>
    <!-- downloaded by 'mvn -N antrun:run@download-schemas' (see the root pom.xml) -->
    <schema.path>sqlserver/2004/SOAP/types/SqlResultStream/SqlResultStream.xsd</schema.path>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>sqlserver-xml-schema-binding-bdf87e</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>sqlserver-xml-schema-binding-b8bc1e</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>sqlserver-xml-schema-binding-b3f54e</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>sqlserver-xml-schema-binding-bfe22e</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <configuration>
          <catalog>${project.basedir}/src/main/catalog/catalog.xml</catalog>
          <!-- the module's schema, and the stub declaring the xsd:schema element the imported SqlSoapTypes.xsd
               references without an import -->
          <schemas>
            <schema>
              <fileset>
                <directory>${schemas.directory}</directory>
                <includes>
                  <include>${schema.path}</include>
                </includes>
              </fileset>
            </schema>
            <schema>
              <fileset>
                <directory>${stubs.directory}</directory>
                <includes>
                  <include>xml-schema.xml</include>
                </includes>
              </fileset>
            </schema>
          </schemas>
          <episodes>
            <episode>
              <groupId>${project.groupId}</groupId>
              <artifactId>sqlserver-xml-schema-binding-bdf87e</artifactId>
            </episode>
            <episode>
              <groupId>${project.groupId}</groupId>
              <artifactId>sqlserver-xml-schema-binding-b8bc1e</artifactId>
            </episode>
            <episode>
              <groupId>${project.groupId}</groupId>
              <artifactId>sqlserver-xml-schema-binding-b3f54e</artifactId>
            </episode>
            <episode>
              <groupId>${project.groupId}</groupId>
              <artifactId>sqlserver-xml-schema-binding-bfe22e</artifactId>
            </episode>
          </episodes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
