<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  version="3.0">

  <!-- the xsd:schema element declared by the root src/stubs/xml-schema.xml, for the imported SqlSoapTypes.xsd (whose
       classes come from sqlserver-xml-schema-binding-bdf87e), is not mapped -->
  <jaxb:bindings scd="x-schema::xsd">
    <jaxb:schemaBindings map="false"/>
  </jaxb:bindings>

</jaxb:bindings>
